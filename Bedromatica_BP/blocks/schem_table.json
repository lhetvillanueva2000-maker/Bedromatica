{
  "format_version": "1.21.80",
  "minecraft:block": {
    "description": {
      "identifier": "bedromatica:schem_table",
      "menu_category": {
        "category": "construction",
        "group": "itemGroup.name.craftingTable"
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": ["minecraft:cardinal_direction"],
          "y_rotation_offset": 180
        }
      }
    },
    "components": {
      "minecraft:geometry": {
        "identifier": "geometry.schem_table"
      },
      "minecraft:material_instances": {
        "*": {
          "texture": "schem_table",
          "render_method": "alpha_test",
          "ambient_occlusion": true,
          "face_dimming": true
        }
      },
      "minecraft:collision_box": {
        "origin": [-8, 0, -8],
        "size": [16, 15, 16]
      },
      "minecraft:selection_box": {
        "origin": [-8, 0, -8],
        "size": [16, 15, 16]
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1.5
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 15
      },
      "minecraft:movable": {
        "movement_type": "immovable"
      },
      "minecraft:light_dampening": 0,
      "minecraft:light_emission": 3,
      "minecraft:map_color": "#1D375E",
      "minecraft:flammable": {
        "catch_chance_modifier": 0,
        "destroy_chance_modifier": 0
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'north'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 0, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'east'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 90, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'south'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 180, 0] }
        }
      },
      {
        "condition": "q.block_state('minecraft:cardinal_direction') == 'west'",
        "components": {
          "minecraft:transformation": { "rotation": [0, 270, 0] }
        }
      }
    ]
  }
}
